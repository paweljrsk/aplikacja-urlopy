# Local development only; do not use these values on a company server.
# Use URI-safe values (letters/numbers/hyphens) for passwords interpolated into DSNs.
DEPLOY_PORT=8080
BIND_ADDRESS=127.0.0.1
# make env substitutes the current user's IDs when creating .env for the first time.
# If copying this file manually, set these to id -u and id -g on Linux/WSL.
LOCAL_UID=1000
LOCAL_GID=1000
APP_SECRET=local-development-secret-change-before-use
MYSQL_DATABASE=calendar
MYSQL_USER=notus
MYSQL_PASSWORD=local-dev-password
MYSQL_ROOT_PASSWORD=local-dev-root
REDIS_PASSWORD=local-dev-redis
RABBITMQ_DEFAULT_USER=notus
RABBITMQ_DEFAULT_PASS=local-dev-rabbit
