# Safe development defaults only. Compose overrides these with the root .env.
# Production must supply APP_ENV=prod and its own secrets/connection settings.
APP_ENV=dev
APP_SECRET=dev-only-not-a-production-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080
REDIS_URL=redis://:pass1234@redis:6378
MESSENGER_TRANSPORT_DSN=amqp://notus:pass1234@rabbit:5672/%2f/messages
DATABASE_URL="mysql://notus:pass1234@mysql:3306/calendar?serverVersion=8.0.32&charset=utf8mb4"
